<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EduManage Pro — Gestão Acadêmica</title>
    <!-- Bootstrap 5 CSS -->
    <link href="//cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="//cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #f8f9fa; }
        .navbar-brand { font-weight: 700; letter-spacing: 0.5px; }
        .card-dash { border: none; border-radius: 10px; transition: transform 0.2s; }
        .card-dash:hover { transform: translateY(-3px); }
        .table-responsive { background: #fff; border-radius: 8px; padding: 15px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">

<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
  <div class="container">
    <a class="navbar-brand text-warning" href="/"><i class="bi bi-mortarboard-fill me-2"></i>EduManage Pro</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav ms-auto">
        <li class="nav-item">
          <a class="nav-link <%= currentPath === '/' ? 'active fw-bold' : '' %>" href="/"><i class="bi bi-speedometer2 me-1"></i> Dashboard</a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= currentPath.startsWith('/professor') ? 'active fw-bold' : '' %>" href="/professor/lst"><i class="bi bi-person-badge me-1"></i> Professores</a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= currentPath.startsWith('/disciplina') ? 'active fw-bold' : '' %>" href="/disciplina/lst"><i class="bi bi-journal-bookmark me-1"></i> Disciplinas</a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= currentPath.startsWith('/curso') ? 'active fw-bold' : '' %>" href="/curso/lst"><i class="bi bi-building me-1"></i> Cursos</a>
        </li>
      </ul>
    </div>
  </div>
</nav>

<div class="container my-4">
