<%- include('../cabecalho') %>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-person-badge me-2 text-primary"></i>Gerenciamento de Professores</h2>
    <a href="/professor/add" class="btn btn-success"><i class="bi bi-plus-circle me-1"></i> Novo Professor</a>
</div>

<!-- Filtro / Pesquisa -->
<div class="card mb-4 border-0 shadow-sm">
    <div class="card-body bg-white rounded">
        <form action="/professor/lst" method="GET" class="row g-2">
            <div class="col-md-10">
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" name="pesquisa" class="form-control" placeholder="Pesquisar professor por nome..." value="<%= typeof pesquisa !== 'undefined' ? pesquisa : '' %>">
                </div>
            </div>
            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-primary">Pesquisar</button>
            </div>
        </form>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-dark">
            <tr>
                <th>Nome</th>
                <th>E-mail</th>
                <th>Especialidade</th>
                <th>Situação</th>
                <th class="text-center" style="width: 180px;">Ações</th>
            </tr>
        </thead>
        <tbody>
            <% if (professores.length > 0) { %>
                <% professores.forEach(prof => { %>
                    <tr>
                        <td class="fw-bold"><%= prof.nome %></td>
                        <td><%= prof.email %></td>
                        <td><%= prof.especialidade %></td>
                        <td>
                            <% if (prof.ativo) { %>
                                <span class="badge bg-success">Ativo</span>
                            <% } else { %>
                                <span class="badge bg-secondary">Inativo</span>
                            <% } %>
                        </td>
                        <td class="text-center">
                            <!-- Botão Visualizar (Modal) -->
                            <button class="btn btn-sm btn-info text-white me-1" data-bs-toggle="modal" data-bs-target="#modalVerProf<%= prof._id %>" title="Visualizar Detalhes"><i class="bi bi-eye"></i></button>
                            <!-- Botão Editar -->
                            <a href="/professor/edt/<%= prof._id %>" class="btn btn-sm btn-warning me-1" title="Editar"><i class="bi bi-pencil"></i></a>
                            <!-- Form Excluir (POST seguro) -->
                            <form action="/professor/del/<%= prof._id %>" method="POST" class="d-inline" onsubmit="return confirm('Deseja realmente excluir este professor?');">
                                <button type="submit" class="btn btn-sm btn-danger" title="Excluir"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>

                    <!-- Modal Visualizar Detalhes -->
                    <div class="modal fade" id="modalVerProf<%= prof._id %>" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content">
                                <div class="modal-header bg-info text-white">
                                    <h5 class="modal-title"><i class="bi bi-person-badge me-2"></i>Detalhes do Professor</h5>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
                                </div>
                                <div class="modal-body text-start">
                                    <p><strong>Nome Completo:</strong> <%= prof.nome %></p>
                                    <p><strong>E-mail Institucional:</strong> <%= prof.email %></p>
                                    <p><strong>Especialidade / Área:</strong> <%= prof.especialidade %></p>
                                    <p><strong>Situação Cadastral:</strong> <%= prof.ativo ? 'Ativo' : 'Inativo' %></p>
                                    <p class="text-muted small mb-0">Cadastrado em: <%= new Date(prof.createdAt).toLocaleDateString('pt-BR') %></p>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">Nenhum professor encontrado.</td>
                </tr>
            <% } %>
        </tbody>
    </table>
</div>

<%- include('../rodape') %>
