<%- include('../cabecalho') %>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-warning text-dark py-3">
                <h4 class="mb-0"><i class="bi bi-pencil-square me-2"></i>Editar Professor</h4>
            </div>
            <div class="card-body p-4">
                <% if (typeof erro !== 'undefined' && erro) { %>
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i><%= erro %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                <% } %>

                <form action="/professor/edt/<%= professor._id %>" method="POST">
                    <div class="mb-3">
                        <label for="nome" class="form-label fw-bold">Nome Completo:</label>
                        <input type="text" class="form-control" id="nome" name="nome" value="<%= professor.nome %>" required>
                    </div>

                    <div class="mb-3">
                        <label for="email" class="form-label fw-bold">E-mail Institucional:</label>
                        <input type="email" class="form-control" id="email" name="email" value="<%= professor.email %>" required>
                    </div>

                    <div class="mb-3">
                        <label for="especialidade" class="form-label fw-bold">Especialidade / Área:</label>
                        <input type="text" class="form-control" id="especialidade" name="especialidade" value="<%= professor.especialidade %>" required>
                    </div>

                    <div class="mb-3">
                        <label for="ativo" class="form-label fw-bold">Situação Cadastral:</label>
                        <select class="form-select" id="ativo" name="ativo" required>
                            <option value="true" <%= professor.ativo ? 'selected' : '' %>>Ativo</option>
                            <option value="false" <%= !professor.ativo ? 'selected' : '' %>>Inativo</option>
                        </select>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a href="/professor/lst" class="btn btn-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i> Atualizar Professor</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<%- include('../rodape') %>
