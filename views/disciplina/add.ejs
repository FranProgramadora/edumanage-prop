<%- include('../cabecalho') %>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-success text-white py-3">
                <h4 class="mb-0"><i class="bi bi-journal-plus me-2"></i>Cadastrar Nova Disciplina</h4>
            </div>
            <div class="card-body p-4">
                <% if (typeof erro !== 'undefined' && erro) { %>
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i><%= erro %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                <% } %>

                <form action="/disciplina/add" method="POST">
                    <div class="mb-3">
                        <label for="codigo" class="form-label fw-bold">Código da Disciplina:</label>
                        <input type="text" class="form-control" id="codigo" name="codigo" value="<%= typeof dados !== 'undefined' ? dados.codigo : '' %>" placeholder="Ex: DISC-BACKEND-01" required>
                    </div>

                    <div class="mb-3">
                        <label for="nome" class="form-label fw-bold">Nome da Disciplina:</label>
                        <input type="text" class="form-control" id="nome" name="nome" value="<%= typeof dados !== 'undefined' ? dados.nome : '' %>" placeholder="Ex: Desenvolvimento Back-End" required>
                    </div>

                    <div class="mb-3">
                        <label for="cargaHoraria" class="form-label fw-bold">Carga Horária (em horas):</label>
                        <input type="number" class="form-control" id="cargaHoraria" name="cargaHoraria" value="<%= typeof dados !== 'undefined' ? dados.cargaHoraria : '' %>" placeholder="Ex: 75" min="1" required>
                    </div>

                    <div class="mb-3">
                        <label for="ativa" class="form-label fw-bold">Status de Oferta:</label>
                        <select class="form-select" id="ativa" name="ativa" required>
                            <option value="true" <%= typeof dados !== 'undefined' && dados.ativa === 'true' ? 'selected' : '' %>>Ativa</option>
                            <option value="false" <%= typeof dados !== 'undefined' && dados.ativa === 'false' ? 'selected' : '' %>>Inativa</option>
                        </select>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a href="/disciplina/lst" class="btn btn-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-success"><i class="bi bi-check-circle me-1"></i> Salvar Disciplina</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<%- include('../rodape') %>
