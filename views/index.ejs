<%- include('cabecalho') %>

<div class="row mb-4">
    <div class="col-md-12">
        <div class="p-4 bg-white rounded shadow-sm">
            <h2 class="h4 text-primary font-weight-bold mb-2"><i class="bi bi-house-door me-2"></i>Painel Administrativo</h2>
            <p class="text-muted mb-0">Bem-vindo ao <strong>EduManage Pro</strong>. Selecione uma das opções abaixo ou navegue pelo menu para gerenciar o corpo docente, disciplinas e cursos.</p>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card card-dash bg-primary text-white shadow">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase fw-bold text-white-50">Professores</h6>
                        <h2 class="display-6 fw-bold mb-0"><%= totalProfessores %></h2>
                    </div>
                    <i class="bi bi-person-badge display-4"></i>
                </div>
                <hr class="my-3 text-white-50">
                <a href="/professor/lst" class="text-white text-decoration-none fw-bold small">Gerenciar Professores <i class="bi bi-arrow-right ms-1"></i></a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card card-dash bg-success text-white shadow">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase fw-bold text-white-50">Disciplinas</h6>
                        <h2 class="display-6 fw-bold mb-0"><%= totalDisciplinas %></h2>
                    </div>
                    <i class="bi bi-journal-bookmark display-4"></i>
                </div>
                <hr class="my-3 text-white-50">
                <a href="/disciplina/lst" class="text-white text-decoration-none fw-bold small">Gerenciar Disciplinas <i class="bi bi-arrow-right ms-1"></i></a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card card-dash bg-warning text-dark shadow">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase fw-bold text-black-50">Cursos</h6>
                        <h2 class="display-6 fw-bold mb-0"><%= totalCursos %></h2>
                    </div>
                    <i class="bi bi-building display-4 text-dark"></i>
                </div>
                <hr class="my-3 text-dark-50">
                <a href="/curso/lst" class="text-dark text-decoration-none fw-bold small">Gerenciar Cursos <i class="bi bi-arrow-right ms-1"></i></a>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white fw-bold py-3">
                <i class="bi bi-rocket-takeoff me-2 text-primary"></i>Ações Rápidas de Cadastro
            </div>
            <div class="card-body">
                <div class="d-flex flex-wrap gap-2">
                    <a href="/professor/add" class="btn btn-outline-primary"><i class="bi bi-person-plus me-1"></i> Novo Professor</a>
                    <a href="/disciplina/add" class="btn btn-outline-success"><i class="bi bi-journal-plus me-1"></i> Nova Disciplina</a>
                    <a href="/curso/add" class="btn btn-outline-warning text-dark"><i class="bi bi-building-plus me-1"></i> Novo Curso</a>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('rodape') %>
