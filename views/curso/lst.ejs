<%- include('../cabecalho') %>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-building me-2 text-warning"></i>Gerenciamento de Cursos</h2>
    <a href="/curso/add" class="btn btn-warning text-dark fw-bold"><i class="bi bi-plus-circle me-1"></i> Novo Curso</a>
</div>

<!-- Filtro / Pesquisa -->
<div class="card mb-4 border-0 shadow-sm">
    <div class="card-body bg-white rounded">
        <form action="/curso/lst" method="GET" class="row g-2">
            <div class="col-md-10">
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" name="pesquisa" class="form-control" placeholder="Pesquisar curso por nome..." value="<%= typeof pesquisa !== 'undefined' ? pesquisa : '' %>">
                </div>
            </div>
            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-warning text-dark fw-bold">Pesquisar</button>
            </div>
        </form>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-dark">
            <tr>
                <th>Código</th>
                <th>Nome do Curso</th>
                <th>Turno</th>
                <th>Situação</th>
                <th class="text-center" style="width: 180px;">Ações</th>
            </tr>
        </thead>
        <tbody>
            <% if (cursos.length > 0) { %>
                <% cursos.forEach(c => { %>
                    <tr>
                        <td class="fw-bold"><%= c.codigo %></td>
                        <td><%= c.nome %></td>
                        <td><%= c.turno %></td>
                        <td>
                            <% if (c.ativo) { %>
                                <span class="badge bg-success">Ativo</span>
                            <% } else { %>
                                <span class="badge bg-secondary">Inativo</span>
                            <% } %>
                        </td>
                        <td class="text-center">
                            <!-- Botão Visualizar -->
                            <button class="btn btn-sm btn-info text-white me-1" data-bs-toggle="modal" data-bs-target="#modalVerCurso<%= c._id %>" title="Visualizar Detalhes"><i class="bi bi-eye"></i></button>
                            <!-- Botão Editar -->
                            <a href="/curso/edt/<%= c._id %>" class="btn btn-sm btn-warning me-1" title="Editar"><i class="bi bi-pencil"></i></a>
                            <!-- Form Excluir (POST seguro) -->
                            <form action="/curso/del/<%= c._id %>" method="POST" class="d-inline" onsubmit="return confirm('Deseja realmente excluir este curso?');">
                                <button type="submit" class="btn btn-sm btn-danger" title="Excluir"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>

                    <!-- Modal Visualizar Detalhes -->
                    <div class="modal fade" id="modalVerCurso<%= c._id %>" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content">
                                <div class="modal-header bg-warning text-dark">
                                    <h5 class="modal-title"><i class="bi bi-building me-2"></i>Detalhes do Curso</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                                </div>
                                <div class="modal-body text-start">
                                    <p><strong>Código do Curso:</strong> <%= c.codigo %></p>
                                    <p><strong>Nome Oficial:</strong> <%= c.nome %></p>
                                    <p><strong>Turno de Oferta:</strong> <%= c.turno %></p>
                                    <p><strong>Situação Cadastral:</strong> <%= c.ativo ? 'Ativo' : 'Inativo' %></p>
                                    <p class="text-muted small mb-0">Cadastrado em: <%= new Date(c.createdAt).toLocaleDateString('pt-BR') %></p>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">Nenhum curso encontrado.</td>
                </tr>
            <% } %>
        </tbody>
    </table>
</div>

<%- include('../rodape') %>
