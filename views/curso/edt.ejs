<%- include('../cabecalho') %>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-warning text-dark py-3">
                <h4 class="mb-0"><i class="bi bi-pencil-square me-2"></i>Editar Curso</h4>
            </div>
            <div class="card-body p-4">
                <% if (typeof erro !== 'undefined' && erro) { %>
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i><%= erro %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                <% } %>

                <form action="/curso/edt/<%= curso._id %>" method="POST">
                    <div class="mb-3">
                        <label for="codigo" class="form-label fw-bold">Código do Curso:</label>
                        <input type="text" class="form-control" id="codigo" name="codigo" value="<%= curso.codigo %>" required>
                    </div>

                    <div class="mb-3">
                        <label for="nome" class="form-label fw-bold">Nome do Curso:</label>
                        <input type="text" class="form-control" id="nome" name="nome" value="<%= curso.nome %>" required>
                    </div>

                    <div class="mb-3">
                        <label for="turno" class="form-label fw-bold">Turno de Oferta:</label>
                        <select class="form-select" id="turno" name="turno" required>
                            <option value="EaD (Distancia)" <%= curso.turno === 'EaD (Distancia)' ? 'selected' : '' %>>EaD (Distancia)</option>
                            <option value="Noturno" <%= curso.turno === 'Noturno' ? 'selected' : '' %>>Noturno</option>
                            <option value="Matutino" <%= curso.turno === 'Matutino' ? 'selected' : '' %>>Matutino</option>
                            <option value="Vespertino" <%= curso.turno === 'Vespertino' ? 'selected' : '' %>>Vespertino</option>
                            <option value="Integral" <%= curso.turno === 'Integral' ? 'selected' : '' %>>Integral</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="ativo" class="form-label fw-bold">Situação Cadastral:</label>
                        <select class="form-select" id="ativo" name="ativo" required>
                            <option value="true" <%= curso.ativo ? 'selected' : '' %>>Ativo</option>
                            <option value="false" <%= !curso.ativo ? 'selected' : '' %>>Inativo</option>
                        </select>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a href="/curso/lst" class="btn btn-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i> Atualizar Curso</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<%- include('../rodape') %>
